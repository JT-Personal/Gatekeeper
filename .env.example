POSTGRES_PASSWORD=replace-with-a-strong-unique-password
APP_PORT=8080
APP_BIND=127.0.0.1

# Use trusted mode for loopback-only development or oidc for a shared instance.
AUTH_MODE=trusted
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_APP_URL=
AUTH_ALLOWED_GROUP=gatekeeper-founders
AUTH_ADMIN_GROUP=gatekeeper-admins
